# Copy this file to .env and fill in the values. Never commit .env.

# Serve the app under a sub-path, e.g. datacrumbs.org/appointment.
# Leave unset locally so the app stays at "/". Set to /appointment on Vercel.
# NEXT_PUBLIC_BASE_PATH=/appointment

# --- LMS student eligibility ---
# Only students the LMS approves can book. Both values are server-side only;
# they must never be prefixed with NEXT_PUBLIC_.
LMS_ELIGIBILITY_URL=
# Must match APPOINTMENT_API_KEY in the LMS. Generate: openssl rand -hex 32
LMS_API_KEY=

# --- Google Sheets booking sync ---

# The long id from your sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=

# Tab name inside the spreadsheet. Defaults to "Bookings" if left unset.
GOOGLE_SHEET_NAME=Bookings

# From the service account JSON key: the "client_email" field.
# Remember to share the spreadsheet with this address as an Editor.
GOOGLE_CLIENT_EMAIL=

# From the service account JSON key: the "private_key" field.
# Keep the surrounding quotes and the literal \n sequences exactly as they
# appear in the JSON file — they are expanded back to newlines at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
